{
  "name": "deernova-style",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "deernova-style",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ],
      "devDependencies": {
        "marked": "18.1.2"
      },
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/@deernova/style": {
      "resolved": "packages/style",
      "link": true
    },
    "node_modules/@deernova/tokens": {
      "resolved": "packages/tokens",
      "link": true
    },
    "node_modules/@deernova/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "node_modules/marked": {
      "version": "18.1.2",
      "resolved": "https://registry.npmjs.org/marked/-/marked-18.1.2.tgz",
      "integrity": "sha512-DfOnvLAQ6WYeWxWO1u4RyFOeqyHup6dks5PPqnoFiooU7ipRvidO/2j8plhAHIiZg574E9ZlzSjUiPMLAzFkgg==",
      "dev": true,
      "license": "MIT",
      "bin": {
        "marked": "bin/marked.js"
      },
      "engines": {
        "node": ">= 20"
      }
    },
    "packages/style": {
      "name": "@deernova/style",
      "version": "0.1.0",
      "bin": {
        "deernova-style": "bin/cli.mjs"
      },
      "engines": {
        "node": ">=22"
      }
    },
    "packages/tokens": {
      "name": "@deernova/tokens",
      "version": "0.1.0",
      "engines": {
        "node": ">=22"
      }
    },
    "packages/ui": {
      "name": "@deernova/ui",
      "version": "0.1.0",
      "engines": {
        "node": ">=22"
      },
      "peerDependencies": {
        "@deernova/tokens": "0.1.0"
      }
    }
  }
}
