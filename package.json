{
  "name": "deernova-style",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/style",
    "packages/icons"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/build-site.mjs",
    "pack:site": "node scripts/package-site.mjs",
    "setup:one": "bash scripts/bootstrap-one.sh",
    "doctor": "node scripts/deploy-one.mjs check",
    "status": "node scripts/deploy-one.mjs status",
    "deploy": "node scripts/deploy-one.mjs deploy",
    "rollback": "node scripts/deploy-one.mjs rollback",
    "build:skill": "node scripts/build-skill.mjs",
    "tokens": "node scripts/tokens.mjs",
    "screens": "node scripts/render-screens.mjs",
    "dev": "vite",
    "preview": "npm run build:site && node scripts/serve.mjs",
    "test": "npm run build && node --test",
    "check": "npm test",
    "pack": "npm run build:skill && npm pack --workspace @deernova/style --pack-destination releases",
    "release:version": "node scripts/version.mjs",
    "release:publish": "npm test && node scripts/publish.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "devDependencies": {
    "lucide-static": "1.61.0",
    "marked": "18.1.2",
    "vite": "8.3.5"
  }
}
