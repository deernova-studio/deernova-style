{
  "name": "@deernova/icons",
  "version": "0.4.0",
  "type": "module",
  "description": "Deernova icons and loaders: 24×24 stroke icons for AI apps, plus single-stroke loaders that travel along mathematical curves",
  "license": "MIT",
  "files": [
    "dist",
    "loaders.mjs",
    "loaders.d.ts",
    "LICENSE",
    "LICENSE-LUCIDE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./sprite.svg": "./dist/sprite.svg",
    "./svg/*": "./dist/svg/*",
    "./icons.json": "./dist/icons.json",
    "./loaders": {
      "types": "./loaders.d.ts",
      "default": "./loaders.mjs"
    }
  },
  "scripts": {
    "prepack": "node ../../scripts/icons.mjs build"
  },
  "publishConfig": {
    "access": "public"
  }
}
