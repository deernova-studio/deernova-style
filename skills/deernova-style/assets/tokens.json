{
  "name": "Deernova",
  "version": 4,
  "themes": [
    {
      "id": "light",
      "name": "浅色"
    },
    {
      "id": "dark",
      "name": "深色"
    }
  ],
  "densities": [
    {
      "id": "desktop",
      "name": "桌面",
      "scenes": "Web 应用 · macOS 内容区",
      "note": "指针操作。tokens.css 的默认值：正文 15/24，控件 28，侧边栏行 32。macOS 的侧边栏、工具栏、菜单用系统控件和系统尺寸，自己画的内容区用这一档。"
    },
    {
      "id": "touch",
      "name": "触控",
      "scenes": "iOS · iPadOS · Web 触屏",
      "note": "手指操作。正文 17pt，按钮看起来 36pt，点击区域至少 44pt。"
    },
    {
      "id": "comfortable",
      "name": "舒展",
      "scenes": "官网与文档",
      "note": "以阅读为主。字号和留白更大，控件只用于少量导航。"
    }
  ],
  "scenes": [
    {
      "id": "web",
      "name": "Web 应用",
      "density": "desktop",
      "input": "指针",
      "apply": "tokens.css 的默认值",
      "reference": "references/scenes/web.md"
    },
    {
      "id": "web-touch",
      "name": "Web 触屏",
      "density": "touch",
      "input": "触摸",
      "apply": "`@media (pointer: coarse)` 自动切换",
      "reference": "references/scenes/web.md"
    },
    {
      "id": "macos",
      "name": "macOS",
      "density": "desktop",
      "input": "指针",
      "apply": "系统控件用系统尺寸；内容区用 `DeernovaTokens.swift` 的 `#if os(macOS)`",
      "reference": "references/scenes/macos.md"
    },
    {
      "id": "ios",
      "name": "iOS",
      "density": "touch",
      "input": "触摸",
      "apply": "`DeernovaTokens.swift` 的 `#else`",
      "reference": "references/scenes/ios.md"
    },
    {
      "id": "ipados",
      "name": "iPadOS",
      "density": "touch",
      "input": "触摸和指针",
      "apply": "同 iOS；分栏布局另见场景说明",
      "reference": "references/scenes/ipados.md"
    },
    {
      "id": "marketing",
      "name": "官网与文档",
      "density": "comfortable",
      "input": "指针",
      "apply": "根元素加 `data-density=\"comfortable\"`",
      "reference": "references/scenes/web-marketing.md"
    }
  ],
